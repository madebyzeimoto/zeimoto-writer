{
  "name": "zeimoto/writer",
  "description": "An inline-only extension of the Kirby Writer field.",
  "type": "kirby-plugin",
  "license": "MIT",
  "keywords": [
    "kirby",
    "kirby6",
    "zeimoto",
    "writer"
  ],
  "authors": [
    {
      "name": "zeimoto"
    }
  ],
  "require": {
    "php": "^8.5",
    "getkirby/cms": "^6.0",
    "getkirby/composer-installer": "^1.2.1"
  },
  "extra": {
    "installer-name": "zeimoto-writer"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "allow-plugins": {
      "getkirby/composer-installer": true
    }
  }
}
